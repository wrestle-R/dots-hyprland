//@ pragma UseQApplication
import QtQuick
import QtQuick.Window
import Quickshell
import Quickshell.Io
import "theme" as Theme
ShellRoot {
    id: test
    property int requests: 0
    property bool submittedEmptyPassword: false
    QtObject {
        id: backend
        property bool canSuspend: true
        property bool canReboot: true
        property bool canPowerOff: true
        signal loginFailed()
        signal loginSucceeded()
        signal informationMessage(string text)
        function login(user,password,session) {
            test.requests++;
            test.submittedEmptyPassword = password.length === 0;
        }
        function suspend() {}
        function reboot() {}
        function powerOff() {}
    }
    QtObject { id: mockUsers; property string lastUser: "tester" }
    ListModel { id: mockSessions; property int lastIndex: 0; ListElement { name: "Hyprland" } ListElement { name: "Other session" } }
    function named(item,name) { if(item.objectName===name)return item;for(const child of item.children||[]){const hit=named(child,name);if(hit)return hit;}return null; }
    IpcHandler {
        target: "themeTest"
        function status(): string { return JSON.stringify({requests:test.requests,submitting:scene.submitting,failed:scene.loginError,notice:scene.notice,passwordEmpty:test.named(scene,"passwordField").text.length===0,passwordFocused:test.named(scene,"passwordField").activeFocus,masked:test.named(scene,"passwordField").echoMode===TextInput.Password}); }
        function passwordOnly(): bool { return !test.named(scene, "fingerprintButton"); }
        function layout(): string {
            const user = test.named(scene, "usernameField");
            const password = test.named(scene, "passwordField");
            const session = test.named(scene, "sessionPicker");
            const power = test.named(scene, "powerControls");
            const controls = test.named(scene, "authControls");
            return JSON.stringify({
                powerFits: power.width <= controls.width,
                powerBottom: power.mapToItem(scene, 0, power.height).y,
                powerRight: power.mapToItem(scene, power.width, 0).x,
                sceneHeight: scene.height,
                sceneWidth: scene.width,
                insets: [user.leftPadding, password.leftPadding, session.leftPadding],
                widths: [user.width, password.width, session.width],
                heights: [user.height, password.height, session.height],
                gaps: [password.y - user.y - user.height, session.y - password.y - password.height]
            });
        }
        function credentials(): void { test.named(scene,"usernameField").text="tester";test.named(scene,"passwordField").text="test-fixture-only"; }
        function emptyUser(): void { test.named(scene,"usernameField").text=""; }
        function noSession(): void { test.named(scene,"sessionPicker").currentIndex=-1; }
        function selectSession(): void { test.named(scene,"sessionPicker").currentIndex=1; }
        function submit(): void { scene.login(); }
        function fail(): void { backend.loginFailed(); }
        function success(): void { backend.loginSucceeded(); }
        function info(): void { backend.informationMessage("<b>literal message</b>"); }
        function resize(width: int, height: int): void { previewWindow.width = width; previewWindow.height = height; }
        function capture(path: string): void { scene.grabToImage(function(result) { result.saveToFile(path); }); }
        function close(): void { Qt.quit(); }
    }
    Window {
        id: previewWindow
        visible: true
        width: 1000; height: 625
        title: "Disposable SDDM theme test"
        Theme.Main { id: scene; anchors.fill: parent; authBackend: backend; users: mockUsers; sessions: mockSessions }
    }
}
